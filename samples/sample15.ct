c3d()
sz(720,320)
geometry=new(T.BoxGeometry, [36,9,420])
prop=Obj()
prop.color=(0x0099FF)
material=new(T.MeshPhongMaterial,[prop])
for(i,0,20){
    mesh = new(T.Mesh, [geometry,material] )
    mesh.position.x=(i*36-36*10+36/2)
    scene.add( mesh )
}
directionalLight=new(T.DirectionalLight, [0xffffff, 0.5] )
directionalLight.position.set(0,0,1)
scene.add( directionalLight );
frame(){
    for(i,0,20){
        scene.children[i].rotation.x+=(nz(c/(100+i))/10)
        scene.children[i].rotation.z+=(nz(c/(190+i/3))/10)
    }
}