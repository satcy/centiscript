sz(720,720)
bg(180)
a=(10)
frame()
{
    translate(cx,cy)
    a=map(cos(c/500),-1,1,3,30)
    for(i,0,30){
        col(i%5<4?0:255,map(sin(c/321),-1,1,5,70))
        rotate(c/40+i*PI/GOLD)
        for(j,-30,30){
            line(j*10,nz(c/6,(j)/a)*0*(60-abs(j)),(j+1)*10,nz(c/6,(j+1)/a)*0*(60-abs(j+1)))
        }
    }
}
