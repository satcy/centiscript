sz(720,360)bg(200)bpm(30)num=(48)
arr=([])
for(i,0,num){v=vec2(0,60*floor(i/4))arr.push(v)}
to=func(){
    for(i,0,num){
        v=(arr[i])
        tween(v).to(vec2(getBitmapFontCode(floor(rnd(0x20,0x7f))),v.y),200+i*30).easing(eases[2]).start()
    }
}
to()
frame(){
    clr()
    for(i,0,num){
        col(i*3)
        v=(arr[i])
        bm5x8(floor(v.x),5+v.y,5+(i%4)*90,10)
    }
}
beat(){ to() }