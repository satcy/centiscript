sz(720,360)font(60)bg(203,201,190)v=vec2(0)
frame(){
clr()col(70)
dropShadow(5,5,0,0x888877)
n=floor(v.x)
text("0x"+n.toString(16).toUpperCase(),225,85)
scale(45,45)
for(i,0,40){
    if ( n & 1 ) {rect(i%5, floor(i/5),0.9,0.9)}
    n=(n>>1)
}
}
beat(){
    tween(v).to(vec2(rnd(pow(2,40))),100).easing(ease.Bounce.Out).start()
}