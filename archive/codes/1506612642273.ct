sz(500,500)
bg(200)
bpm(120,4)
colors=([0xc5994c,0xff3355,0x2039ef])
sc=([1])
rot=(0)
frame()
{
    clr()
    dropShadow(0,0,32,0xffffff)
    translate(cx,cy)
    for(i,0,3){
        hcol(colors[(i+beat)%3])
        push()
        rotate(rot)
        scale(i==2?min(sc[0],1):1,1)
        oval(0,0,h/2.3)
        pop()
    }
}
beat()
{
    rot=rnd(PI)
    sc=([0])
    tsc=([1])
    tween(sc).to(tsc,500).easing(ExpoInOut).start()
}
