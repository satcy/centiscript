sz(405,720)
bg(0)
p=vec2()
p.v=vec2()
p.r=(20)
offy=(0)
hist=([])
cnt=(0)
score=(0)
frame()
{
    clr()
    col(170)
    push()
    translate(cx,cy+offy)
    hist.push(vec2(p.x,p.y))
    if(hist.length>5){
        hist.shift()
    }
    for(i,0,hist.length-1){
        for(j,0,10){
            oval(interp(hist[i].x,hist[i+1].x,j/9),interp(hist[i].y,hist[i+1].y,j/9),p.r)
        }
    }
    col(255)
    oval(p.x,p.y,p.r)
    col(170)
    rect(-w/2,0,w,h)
    offy2=(offy%(h*3)+h/2-offy)
    for(i,0,60){
        line(-w/2,-i*54+offy2+h/4,0,-i*54+offy2)
        line(0,-i*54+offy2,w/2,-i*54+offy2+h/4)
    }
    for(i,0,120){
        line(-6,-i*27+offy2,6,-i*27+offy2)
    }
    pop()
    p.x+=(p.v.x)
    p.v.x*=(0.9)
    p.y+=(p.v.y)
    p.v.y+=(0.5)
    p.v.x+=(mx-cx)*(0.01)
    if(p.y>-p.r){
        p.y=(-p.r)
        p.v.y*=(-0.2)
    }
    ww=(w+p.r*2)
    if(p.x<-w/2-p.r){
        p.x+=(ww)
        for(i,0,hist.length){
            hist[i].x+=(ww)
        }
    }
    if(p.x>w/2+p.r){
        p.x-=(ww)
        for(i,0,hist.length){
            hist[i].x-=(ww)
        }
    }
    offy+=(-p.y-offy)*(zmap(abs(p.y-offy),0,h,0.1,0.5,1))
    bmTxt(cnt+"Chain",0,0)
    cs=floor(abs(p.y+p.r))
    bmTxt(cs+" / "+score,0,40)
    if(cs>score){
        score=(cs)
    }
}
down()
{
    if(p.y>-p.r*2){
        if(p.v.y<=0){
            cnt+=(1);
        }
        else{
            cnt=(0);
        }
        p.v.y*=(cnt+1)
        p.v.y-=(12)
    }
}
