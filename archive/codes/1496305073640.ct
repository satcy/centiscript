sz(225,450)
bg(0)
colors=([0xff0000, 0x403976, 0x739848, 0x846730, 0x582934, 0x127399, 0x058f03])
types=([[0x0F00,0x2222,0x00F0,0x4444],[0x44C0,0x8E00,0x6440,0x0E20],[0x4460,0x0E80,0xC440,0x2E00],[0xCC00,0xCC00,0xCC00,0xCC00],[0x06C0,0x8C40,0x6C00,0x4620],[0x0E40,0x4C40,0x4E00,0x4640],[0x0C60,0x4C80,0xC600,0x2640]])
stg=([])
stgColor=([])
ww=(10)
for(i,0,20){
    stg[i]=(0)
    stgColor[i]=([])
    for(sc,0,ww){
        stgColor[i][sc]=(-1)
    }
}
emptyColorRow=func(){
    ecr=([])
    for(ec,0,ww){
        ecr[ec]=(-1)
    }
    return(ecr)
}
fits=func(){
    fx=($0)
    fy=($1)
    fr=($2)
    fv=(types[crr.t][fr])
    fok=(1)
    for(fi,0,16){
        if(fv&1){
            fxx=(fx+floor(fi/4))
            fyy=(fy+fi%4)
            if(fxx<0||fxx>=ww){
                fok=(0)
            }
            if(fyy>=20){
                fok=(0)
            }
            if(fok&&fyy>=0){
                if((stg[fyy]>>fxx)&1){
                    fok=(0)
                }
            }
        }
        fv=(fv>>1)
    }
    return(fok)
}
dropY=func(){
    dr=($0)
    dx=($1)
    if(!fits(dx,-2,dr)){
        return(-999)
    }
    dy=(-2)
    while(fits(dx,dy+1,dr)){
        dy+=(1)
    }
    return(dy)
}
evalPlacement=func(){
    tr=($0)
    tx=($1)
    ty=(dropY(tr,tx))
    if(ty<-900){
        return(-9999999)
    }
    tmp=([])
    for(i,0,20){
        tmp[i]=(stg[i])
    }
    v=(types[crr.t][tr])
    for(i,0,16){
        if(v&1){
            xx=(tx+floor(i/4))
            yy=(ty+i%4)
            if(xx>=0&&xx<ww&&yy>=0&&yy<20){
                tmp[yy]=(tmp[yy]|(1<<xx))
            }
        }
        v=(v>>1)
    }
    clearedLines=(0)
    for(rw,0,20){
        idx2=(19-rw)
        if((tmp[idx2]>>>0)==pow(2,ww)-1){
            clearedLines+=(1)
            for(kk,0,20){
                if(idx2-kk>=0){
                    tmp[idx2-kk]=(idx2-1-kk>=0?tmp[idx2-1-kk]:0)
                }
            }
            rw-=(1)
        }
    }
    colH=([])
    heightSum=(0)
    holeCount=(0)
    for(cc,0,ww){
        topRow=(20)
        for(rw,0,20){
            if((tmp[rw]>>cc)&1){
                if(rw<topRow){
                    topRow=(rw)
                }
            }
        }
        colH[cc]=(20-topRow)
        heightSum+=(20-topRow)
        for(rw,topRow,20){
            if(!((tmp[rw]>>cc)&1)){
                holeCount+=(1)
            }
        }
    }
    bumpiness=(0)
    maxH=(0)
    for(cc,0,ww){
        if(cc<ww-1){
            bumpiness+=abs(colH[cc]-colH[cc+1])
        }
        if(colH[cc]>maxH){
            maxH=(colH[cc])
        }
    }
    plScore=(clearedLines*500-heightSum*800-holeCount*900-bumpiness*300-maxH*250)
    return(plScore)
}
pickBest=func(){
    bestScore=(-99999999)
    bestX=floor(ww/2-2)
    bestR=(0)
    for(tr,0,4){
        for(tx,-3,ww){
            s=(evalPlacement(tr,tx))
            if(s>bestScore){
                bestScore=(s)
                bestX=(tx)
                bestR=(tr)
            }
        }
    }
}
nextObj=func(){
    crr=({x:2})
    crr.x=floor(ww/2-2)
    crr.y=(-2)
    crr.t=floor(rnd(7))
    crr.r=(0)
    pickBest()
    crr.r=(bestR)
}
nextObj()
gameover=(0)
cw=(w/ww)
ch=(h/20)
frame()
{
    clr()
    push()
    scale(cw,ch)
    for(j,0,20){
        v=(stg[j])
        for(i,0,ww){
            if(v&1){
                hcol(colors[stgColor[j][i]])
                pixel(i,j)
            }
            v=(v>>1)
        }
    }
    push()
    translate(crr.x,crr.y)
    hcol(colors[crr.t])
    v=(types[crr.t][crr.r])
    for(i,0,16){
        if(v&1){
            pixel(floor(i/4),i%4)
        }
        v=(v>>1)
    }
    pop()
    pop()
    if(!gameover){
        if(crr.x<bestX){
            crr.x+=(2)
            if(crr.x>bestX){
                crr.x=(bestX)
            }
        }
        else{
            if(crr.x>bestX){
                crr.x-=(2)
                if(crr.x<bestX){
                    crr.x=(bestX)
                }
            }
            else{
                proc()
                proc()
                proc()
            }
        }
    }
    else{
        gameover-=(1)
        if(gameover==0){
            for(i,0,20){
                stg[i]=(0)
                stgColor[i]=(emptyColorRow())
            }
            nextObj()
        }
    }
}
proc=func(){
    if(fits(crr.x,crr.y+1,crr.r)){
        crr.y+=(1)
    }
    else{
        v=(types[crr.t][crr.r])
        for(i,0,16){
            if(v&1){
                xx=(crr.x+floor(i/4))
                yy=(crr.y+i%4)
                if(xx>=0&&xx<ww&&yy>=0&&yy<20){
                    stg[yy]=(stg[yy]|(1<<xx))
                    stgColor[yy][xx]=(crr.t)
                }
            }
            v=(v>>1)
        }
        for(j,0,20){
            idx=(19-j)
            if((stg[idx]>>>0)==pow(2,ww)-1){
                for(jj,0,20){
                    if(idx-jj>=0){
                        stg[idx-jj]=(idx-1-jj>=0?stg[idx-1-jj]:0)
                        stgColor[idx-jj]=(idx-1-jj>=0?stgColor[idx-1-jj]:emptyColorRow())
                    }
                }
                j-=(1)
            }
        }
        v=(types[crr.t][crr.r])
        over=(0)
        for(i,0,16){
            if(v&1){
                if(crr.y+i%4<0){
                    over=(1)
                }
            }
            v=(v>>1)
        }
        if(over){
            gameover=(60)
        }
        nextObj()
    }
}
