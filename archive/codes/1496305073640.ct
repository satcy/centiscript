sz(720,450)bg(0)
types=([[0x0F00, 0x2222, 0x00F0, 0x4444],
[0x44C0, 0x8E00, 0x6440, 0x0E20],
[0x4460, 0x0E80, 0xC440, 0x2E00],
[0xCC00, 0xCC00, 0xCC00, 0xCC00],
[0x06C0, 0x8C40, 0x6C00, 0x4620],
[0x0E40, 0x4C40, 0x4E00, 0x4640],
[0x0C60, 0x4C80, 0xC600, 0x2640]])
stg=([])
ww=(32)
for(i,0,20){stg[i]=(0)}
nextObj=func(){
	crr=({x:2})
    crr.x=floor(rnd(ww)-1)
	crr.y=(-2)
	crr.t=floor(rnd(7))
	crr.r=floor(rnd(4))
}
nextObj()
gameover=(0)

sc=(22.5)
frame(){
clr()
col(50)


push()
scale(sc,sc)

for(j,0,20){
	v=(stg[j])
	for(i,0,ww){
		if(v&1) {pixel(i,j)}
		v=(v>>1)
	}
}

push()
translate(crr.x,crr.y)
v=(types[crr.t][crr.r])
for(i,0,16){
	if ( v&1 ) {pixel(floor(i/4),i%4)}
	v=(v>>1)
}
pop()
pop()
if ( !gameover) {
	if(c%1==0){proc()}
} else {
	gameover-=(1)
	if ( gameover == 0 ) {
		for(i,0,20){stg[i]=(0)}
		nextObj()
	}
}
if (down) {erase()}
}

erase = func(){
    idx=(floor(mx/sc) + 32*(floor(my/sc)))
	hitted=(0)
    j=(floor(my/sc))
    temp=([])
    temp2=([])
    for(i,0,ww){
        temp[i]=(0)
        temp2[i]=(0)
    }
    v=(stg[j])
    for(i,0,ww){
        temp[i]=(v&1)
        v=(v>>1)
    }
    i=(floor(mx/sc))
    while(temp[i] && i>=0){
        temp2[i] = (1)
        i-=(1)
    }
    i=(floor(mx/sc))
    while(temp[i] && i<ww){
        temp2[i] = (1)
        i+=(1)
    }
    v=(stg[j])
    nv=(0)
    hitted=(0)
    for(i,0,ww){
        nv=(nv<<1)
        if(v&1) {
            if( temp2[i] ) {
                hitted=(1)
            } else {
                nv +=(1)
            }
        }
        v=(v>>1)
    }
    if ( hitted ) {
        v=(0)
        for(i,0,ww){
            v=(v<<1)
            if (nv&1) {v+=(1)}
            nv=(nv>>1)
        }
        stg[j] = (v)
        temp_stg = ([])
        for(i,0,20){temp_stg[i]=(stg[i])}
        j2=(0)
        while(j2<=j){
            v=(temp_stg[j2])
            v2=(j2==0 ? 0 : temp_stg[j2-1])
            nv=(0)
            for(i,0,ww){
                nv=(nv<<1)
                if(temp2[i]){
                    if(v2&1) {
                        nv+=(1)
                    }
                } else {
                    if(v&1) {
                        nv+=(1)
                    }
                }
                v=(v>>1)
                v2=(v2>>1)
            }
            v=(0)
            for(i,0,ww){
                v=(v<<1)
                if (nv&1) {v+=(1)}
                nv=(nv>>1)
            }
            stg[j2]=(v)
            j2+=(1)
        }
    }
    
}
proc=func(){
	crr.y+=(1)
	v=(types[crr.t][crr.r])
	temp=([])
	hitted=(0)
	for(i,0,16){
		if ( v&1 ) {
            xx = (crr.x + floor(i/4))
            yy = (crr.y + i%4)
            if(xx>=0 && xx<ww) {
			    temp.push(xx + ww*yy)
            }
			if ( crr.y + i%4 >= 20 ) {
				hitted = (1)
			}
		}
		v=(v>>1)
	}
	if ( !hitted ) {
		for(j,0,20){
			v=(stg[j])
			for(i,0,ww){
				if(v&1) {
					if( temp.indexOf(i + ww*j) != -1 ) {
						hitted=(1)
					}
				}
				v=(v>>1)
			}
		}
	}
	if ( hitted ) {
		crr.y-=(1)
		v=(types[crr.t][crr.r])
		temp=([])
		for(i,0,16){
			if ( v&1 ) {
                xx = (crr.x + floor(i/4))
                yy = (crr.y + i%4)
                if(xx>=0 && xx<ww) {
                    temp.push(xx + ww*yy)
                }
            }
			v=(v>>1)
		}
		for(j,0,20){
			v=(stg[j])
			nv=(0)
			for(i,0,ww){
				nv=(nv<<1)
				if(temp.indexOf(ww-1-i + ww*j) != -1 ) {
					nv+=(1)
				}
			}
			stg[j]=(v | nv)
		}
		for(j,0,20){
			idx=(19-j)
			if ( stg[idx] == pow(2,ww) - 1 ) {
                for(jj,0,20) { 
                    if ( idx - jj >= 0 ) {
				        stg[idx-jj] = (idx-1-jj >= 0 ? stg[idx-1-jj] : 0)
                    }
                }
				j-=(1)
			}
		}
		if ( crr.y ) {
			gameover = (0)
			v=(types[crr.t][crr.r])
			for(i,0,16){
				if ( v&1 ) {
					if(crr.y + i%4 < 0){
						gameover=(60)
					}
				}
				v=(v>>1)
			}
		}
		nextObj()
	}
}