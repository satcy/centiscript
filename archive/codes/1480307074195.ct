sz(720,360)bg(237,234,214)a=([1,6,12])
frame(){clr()
col(10)
fill()
circles()
strk()
col(255)
circles()
rw=(w*0.15)
rh=(w*0.15*0.5)
fill()
col(255,80)
rect(w-rw-rh,(h-rh)/2,rw,rh)
strk()
col(10,100)
rect(w-rw-rh,(h-rh)/2,rw,rh)
line(w-rw,h/2-rh/2,w-rw,h/2+rh/2)
col(255,20,0)
line(w-rw,h/2,w-rw+rh/2,h/2)
}
circles=func(){
for(i,0,8){
if(i<a.length){
num=(a[i])
}else{
num+=(4*(i%2+1))
}
for(j,0,num){
oval(cy+cos(j*PI2/num)*i*20, cy+sin(j*PI2/num)*i*20, 5.7);
}
}
}