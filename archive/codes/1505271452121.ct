sz(720,360)
bg(0)
segments=([])
N=(36)
for(i,0,N){
    segments[i]=obj()
    s=(segments[i])
    s.len=(20)
    s.r=(0)
    s.vr=(0.01)
}
frame()
{
    col((cos(c/23)*0.5+0.5)*255)
    p0=vec2(cx/2,cy)
    p1=vec2(cx/2,cy)
    r=(0)
    for(i,0,N){
        s=(segments[i])
        s.vr=(cos(c/23+i/4)*sin(c/93+i/31)*0.02)
        pp=vec2(s.len,0)
        pp=pp.rotate(r)
        p1.x+=(pp.x)
        p1.y+=(pp.y)
        line(p0.x,p0.y,p1.x,p1.y)
        p0.x=(p1.x)
        p0.y=(p1.y)
        r+=(s.r)
        s.r+=(s.vr)
    }
}
